# ---------------------------------------------------------------------------
# Strata Compute — backend service
#
# Copy to .env (or .env.local, both are loaded — .env.local wins) and fill in.
# Never commit a filled file. Every value here is server-side only: nothing in
# this file is ever sent to the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --------------------------------------------------------------- database
#
# PostgreSQL is the source of truth. There is no fallback: with DATA_STORE at
# its default the service refuses to start without a reachable database.
#
# For Supabase, use the SESSION POOLER (port 5432), not the direct host — the
# direct host is IPv6-only. The pooler username carries the project ref:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Percent-encode any reserved character in the password (@ becomes %40).
DATABASE_URL=

# Required by Supabase and by any managed Postgres.
DATABASE_SSL=true

# Optional PEM path. When set, TLS verifies the server certificate against it.
# Without it the connection is encrypted but the server is unauthenticated.
DATABASE_CA_CERT=

# Pooled connections are a shared, limited resource on managed Postgres.
# Must stay below the database's own client ceiling. Supabase's session
# pooler allows 15 in total, so this leaves room for migrations and a manual
# session. Exceeding it surfaces as EMAXCONNSESSION on random requests.
DATABASE_POOL_MAX=12

# postgres | memory. Memory persists nothing and is refused in production.
DATA_STORE=postgres

# --------------------------------------------------------------- retention
#
# Zero means keep everything, which is the default. Market history is the
# input to every historical computation, so deletion is opt-in and explicit.
RETENTION_ENABLED=false
MARKET_HISTORY_RETENTION_DAYS=0
EVENT_RETENTION_DAYS=0

# --- Alchemy / Robinhood Chain --------------------------------------------
# Chain id 4663 is Robinhood Chain mainnet.
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=
ROBINHOOD_WS_URL=
ROBINHOOD_API_URL=https://api.robinhood.com

# --- CoinGecko (crypto markets) -------------------------------------------
COINGECKO_API_KEY=

# --- Blockscout (indexed onchain) -----------------------------------------
# Note: Blockscout has no Robinhood Chain instance. It serves ethereum, base,
# optimism and arbitrum; chain 4663 is handled by Alchemy alone.
BLOCKSCOUT_API_KEY=

# --- Alpha Vantage (equities) ---------------------------------------------
# Free tier is 25 requests per DAY and 1 per second. The limiter enforces both
# locally; raise the limit only if the key is on a paid plan.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25

# --- GoPlus (token security) ----------------------------------------------
# App key + secret are exchanged for a short-lived bearer token.
# GOPLUS_API_KEY is accepted as an alias for GOPLUS_APP_KEY.
GOPLUS_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- data freshness --------------------------------------------------------
# Per-domain cadence. Nothing polls on a hardcoded timer.
MARKET_REFRESH_INTERVAL_SECONDS=120
ONCHAIN_REFRESH_INTERVAL_SECONDS=300
STOCK_REFRESH_INTERVAL_SECONDS=3600
SECURITY_REFRESH_INTERVAL_SECONDS=21600

# --- cache -----------------------------------------------------------------
# memory | none
CACHE_DRIVER=memory
CACHE_URL=
CACHE_TTL_SECONDS=15
CACHE_TTL_MARKET_SECONDS=30
CACHE_TTL_METADATA_SECONDS=86400
CACHE_TTL_SECURITY_SECONDS=21600
CACHE_TTL_RANKINGS_SECONDS=30

# --- background jobs -------------------------------------------------------
# Off by default. The API still serves: startup runs one ingestion pass.
JOBS_ENABLED=false
JOB_INGESTION_INTERVAL_MS=60000
JOB_COMPUTE_INTERVAL_MS=60000
JOB_SIGNALS_INTERVAL_MS=120000
JOB_RANKINGS_INTERVAL_MS=120000
JOB_ARENA_INTERVAL_MS=300000

# --- api -------------------------------------------------------------------
# Comma-separated origin allowlist for the browser-facing frontend.
#
# The localhost value below is a development default. Production refuses to
# start if this still points only at localhost, or if it contains '*' — both
# mean the allowlist was never configured, and neither says so once running.
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------- rate limiting
#
# Per-IP, per-window. Sized for how this is deployed: the browser never calls
# this API, so in practice one IP is every user, and a page render costs four
# to five requests here.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200

# Health and readiness are counted separately, so a probe is never refused —
# a 429 on /health is indistinguishable from a dead instance.
RATE_LIMIT_PROBE_MAX=600

# Believe X-Forwarded-For. Enable ONLY when a proxy in front actually sets it:
# without one, any caller can choose its own rate-limit bucket by sending the
# header.
TRUST_PROXY=false

# --- compute ---------------------------------------------------------------
COMPUTE_VERSION=v1
