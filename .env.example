# ---------------------------------------------------------------------------
# Strata Compute — frontend (Next.js)
#
# Copy to .env.local for local work; set the same variables in your host's
# environment for a deployment.
#
# There are no secrets in this file, and there is no place for one. Anything
# Next.js loads sits in the frontend process, one NEXT_PUBLIC_ prefix away
# from being shipped to the browser. Provider API keys and the database URL
# belong in server/.env — the backend is the only thing that talks to either.
# ---------------------------------------------------------------------------

# Where the Strata API is served from, with no trailing slash.
#
# Read on the server only: every browser request in this application is
# same-origin, and the route handlers in app/api/* proxy to the backend. The
# NEXT_PUBLIC_ prefix is kept because the value is not sensitive and the
# deployment convention expects it.
#
# Required for a production build. There is no localhost fallback outside
# development — a production build without it fails immediately rather than
# coming up pointed at a machine that is not there.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# The port `next start` binds. Most hosts set this for you.
# PORT=3000
